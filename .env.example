# Copy to .env.local for `vercel dev`, and add the same values in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Optional: require this code before anyone can use the AI panel (keeps strangers from spending your API credits).
DEAL_SCHOOL_ACCESS_CODE=
# Optional: model override
ANTHROPIC_MODEL=claude-sonnet-5-5
# Accounts (Supabase). The publishable key is safe in the browser; never use the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
