# Copy to .env.local for `vercel dev`, and add the same values in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Optional: require this code before anyone can use the AI panel (keeps strangers from spending your API credits).
DEAL_SCHOOL_ACCESS_CODE=
# Optional: model override
ANTHROPIC_MODEL=claude-sonnet-5-5
# Accounts (Supabase). The publishable key is safe in the browser; never use the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Market check (all free). Server only: never prefix these with VITE_.
# Census works without a key at low volume: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Live interest rates: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# HUD Fair Market Rents: https://www.huduser.gov/hudapi/public/register
HUD_API_TOKEN=
# County jobs data works without a key (25 calls a day); a key raises it to 500: https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Optional: a cheaper model for the policy briefing, e.g. claude-haiku-5-5
POLICY_MODEL=
